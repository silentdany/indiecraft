{
  "name": "indiecraft",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "crawl": "node --env-file-if-exists=.env --import tsx scripts/crawl.ts",
    "compute": "node --env-file-if-exists=.env --import tsx scripts/compute.ts",
    "schema:apply": "node --env-file-if-exists=.env --import tsx scripts/apply-schema.ts",
    "verify-icons": "node --import tsx scripts/verify-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "audit-icons": "node --import tsx scripts/audit-icons.ts"
  },
  "dependencies": {
    "@vercel/og": "^0.11.1",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.414.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
