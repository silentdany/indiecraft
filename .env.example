# TrustMRR API v1 key, format tmrr_...
TRUSTMRR_API_KEY=

# Postgres (Supabase is only a host here: never supabase-js).
# Transaction pooler, port 6543 — used by the Next app (prepare: false mandatory).
DATABASE_URL=
# Long-lived connection for the crawler.
# Use the SESSION pooler (aws-0-<region>.pooler.supabase.com:5432), not
# db.<ref>.supabase.co:5432 — the latter is IPv6-only and unreachable from
# GitHub Actions runners and most local machines.
DIRECT_URL=

# Protects /api/cron/compute. Vercel Cron sends it as Authorization: Bearer.
CRON_SECRET=

# X OAuth 2.0, for claiming a sheet. Run `bash scripts/setup-x-auth.sh` — it
# walks the developer portal, captures these, and pushes them to Vercel.
#
# While these are empty, claiming and removal are switched off at the route and
# not only in the interface, every sheet stays noindex, and the sitemap holds
# only the three static pages. Nothing else about the site changes.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs the session cookie. Falls back to CRON_SECRET when unset, which works
# but gives one secret two jobs. `openssl rand -base64 32`.
AUTH_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public base URL of the site, for absolute OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
